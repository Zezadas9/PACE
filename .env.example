# Frontend da PACE — variáveis públicas, e só públicas.
#
# Isto entra no bundle que qualquer pessoa consegue ler. É o endereço do Worker,
# não um segredo. A chave da Anthropic vive no Worker, como secret, e nunca
# chega ao browser.
#
# Sem esta variável a aplicação funciona na mesma: o assistente usa o motor
# local, que corre no dispositivo.
VITE_PACE_API_URL=https://SEU-WORKER.workers.dev
