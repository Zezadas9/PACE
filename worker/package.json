{
  "name": "pace-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend da PACE: o unico sitio que fala com a Anthropic API.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret": "wrangler secret put ANTHROPIC_API_KEY",
    "secret:list": "wrangler secret list",
    "login": "wrangler login",
    "whoami": "wrangler whoami"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
